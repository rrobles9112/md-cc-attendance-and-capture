# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CI/CD only (GitHub Actions secrets)
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
SUPABASE_ACCESS_TOKEN=sbp_your-supabase-access-token
SUPABASE_PROJECT_REF=your-project-ref

# Vercel (CI only)
VERCEL_TOKEN=your-vercel-token

# WhatsApp Pastoreo (D2 pending — sandbox provisional)
# Edge fails closed when WHATSAPP creds are empty; inject via `supabase secrets set` + Vault.
# See docs/whatsapp-runbook.md and supabase/migrations/012a*.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
CRON_SECRET=
